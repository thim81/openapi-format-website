---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "@/components/docs/CodeBlock";

const cliOptions = `npx openapi-format <input-file> -o [output-file] [options]

Arguments:
  input-file   the OpenAPI document (local or remote, JSON or YAML)
  output-file  optional output file (.json or .yaml)

Options:
  --output, -o          Save formatted file as JSON/YAML              [path]
  --sortFile            Custom field ordering file                    [path]
  --casingFile          Casing rules file                             [path]
  --generateFile        Generate rules file                           [path]
  --filterFile          Filter rules file                             [path]
  --overlayFile         OpenAPI overlay actions file                  [path]
  --no-sort             Don't sort the OpenAPI file                [boolean]
  --keepComments        Keep YAML comments                         [boolean]
  --sortComponentsFile  Components to sort alphabetically             [path]
  --sortComponentsProps Sort schema properties alphabetically      [boolean]
  --no-bundle           Don't bundle $ref references               [boolean]
  --split               Split into multi-file structure            [boolean]
  --rename              Rename the OpenAPI title                    [string]
  --convertTo           Convert to OpenAPI version 3.1 or 3.2       [string]
  --configFile          Config file with all CLI options              [path]
  --lineWidth           Max line width of YAML output               [number]
  --json                Output as JSON to stdout                   [boolean]
  --yaml                Output as YAML to stdout                   [boolean]
  --playground, -p      Open config in online playground
  --help                Show help                                  [boolean]
  --version             Output version number
  --verbose             Increase output verbosity                    [count]`;
---

<DocsLayout
  title="CLI Options"
  description="Complete reference for all command-line interface options."
  currentPath="/docs/cli-options/"
>
  <h1 class="text-3xl font-bold mb-2">CLI Options</h1>
  <p class="text-muted-foreground mb-8">
    Complete reference for all command-line interface options.
  </p>

  <h2 class="text-2xl font-semibold mt-8 mb-4">Usage</h2>
  <CodeBlock client:idle code={cliOptions} title="CLI" language="text" />

  <h2 class="text-2xl font-semibold mt-8 mb-4">Options Reference</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="border-b">
          <th class="text-left py-2 pr-4 font-semibold">Parameter</th>
          <th class="text-left py-2 pr-4 font-semibold">Alias</th>
          <th class="text-left py-2 pr-4 font-semibold">Description</th>
          <th class="text-left py-2 font-semibold">Default</th>
        </tr>
      </thead>
      <tbody class="text-muted-foreground">
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--output</td>
          <td class="py-2 pr-4 font-mono text-xs">-o</td>
          <td class="py-2 pr-4">Save formatted OpenAPI file</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--sortFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-s</td>
          <td class="py-2 pr-4">Custom field ordering file</td>
          <td class="py-2 font-mono text-xs">defaultSort.json</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--filterFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-f</td>
          <td class="py-2 pr-4">Filter settings file</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--casingFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-k</td>
          <td class="py-2 pr-4">Casing rules file</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--generateFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-g</td>
          <td class="py-2 pr-4">Generate rules file</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--overlayFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-l</td>
          <td class="py-2 pr-4">OpenAPI overlay actions file</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--no-sort</td>
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Don't sort the file</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--keepComments</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Keep YAML comments</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--sortComponentsFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Sort components alphabetically</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--sortComponentsProps</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Sort schema properties alphabetically</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--no-bundle</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Don't bundle $ref references</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--split</td>
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Split into multi-file structure</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--rename</td>
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Rename the OpenAPI title</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--convertTo</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Convert to OpenAPI 3.1 or 3.2</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--configFile</td
          >
          <td class="py-2 pr-4 font-mono text-xs">-c</td>
          <td class="py-2 pr-4">Config file with all options</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground"
            >--lineWidth</td
          >
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Max YAML line width</td>
          <td class="py-2 font-mono text-xs">-1 (&#8734;)</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--json</td>
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Output as JSON to stdout</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--yaml</td>
          <td class="py-2 pr-4 font-mono text-xs"></td>
          <td class="py-2 pr-4">Output as YAML to stdout</td>
          <td class="py-2 font-mono text-xs">false</td>
        </tr>
        <tr class="border-b">
          <td class="py-2 pr-4 font-mono text-xs text-foreground">--verbose</td>
          <td class="py-2 pr-4 font-mono text-xs">-v</td>
          <td class="py-2 pr-4">Increase verbosity</td>
          <td class="py-2 font-mono text-xs"></td>
        </tr>
      </tbody>
    </table>
  </div>
</DocsLayout>
