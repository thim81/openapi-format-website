---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "@/components/docs/CodeBlock";
import PlaygroundExampleLink from "@/components/docs/PlaygroundExampleLink.astro";
---

<DocsLayout
  title="Overlays"
  description="Apply structured update and remove actions to your OpenAPI document using the OpenAPI Overlay Specification."
  currentPath="/docs/overlays"
>
  <h1 class="text-3xl font-bold mb-2">Overlays</h1>
  <p class="text-muted-foreground mb-8">
    Apply structured update and remove actions to your OpenAPI document using
    the{" "}
    <a
      href="https://spec.openapis.org/overlay/v1.0.0.html"
      target="_blank"
      rel="noopener noreferrer"
      class="underline hover:text-foreground"
    >
      OpenAPI Overlay Specification
    </a>.
  </p>
  <a
    href="https://playground.openapi-format.com"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block my-4"
  >
    <span
      class="inline-flex items-center gap-1.5 rounded-md border border-primary/30 bg-background px-3 py-1.5 text-sm font-medium text-primary hover:bg-primary/5"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path
          d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
        ></path></svg
      >
      Try overlays in the Playground
    </span>
  </a>

  <h2 class="text-2xl font-semibold mt-8 mb-4">CLI Usage</h2>
  <CodeBlock
    client:idle
    code={`npx openapi-format openapi.yaml --overlayFile overlay.yaml -o openapi-updated.yaml`}
    title="Terminal"
  />

  <h2 class="text-2xl font-semibold mt-8 mb-4">Overlay Structure</h2>
  <p class="mb-4 text-muted-foreground">
    An overlay document defines actions with JSONPath targets:
  </p>
  <CodeBlock
    client:idle
    code={`overlay: 1.0.0
info:
  title: Example Overlay
  version: 1.0.0
actions:
  - target: "$"
    update:
      info:
        description: "Updated API description."
  - target: "$.paths['/example']"
    update:
      get:
        description: "Updated GET description."
  - target: "$.paths['/example'].get.parameters"
    remove: true`}
    title="overlay.yaml"
  />

  <h2 class="text-2xl font-semibold mt-8 mb-4">Example: Update Description</h2>
  <CodeBlock
    client:idle
    code={`overlay: 1.0.0
info:
  title: Update API info
  version: 1.0.0
actions:
  - target: "$"
    update:
      info:
        description: "The official Pet Store API — production ready."`}
    title="overlay.yaml"
  />
  <PlaygroundExampleLink
    input={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
  description: A sample API
paths:
  /pets:
    get:
      summary: List all pets`}
    config={{
      overlaySet: `overlay: 1.0.0
info:
  title: Update API info
  version: 1.0.0
actions:
  - target: "$"
    update:
      info:
        description: "The official Pet Store API — production ready."`,
      toggleOverlay: true,
      outputLanguage: "yaml",
    }}
  />
  <div class="grid gap-4 md:grid-cols-2 mt-4">
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
  description: A sample API
paths:
  /pets:
    get:
      summary: List all pets`}
      title="Before"
    />
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
  description: "The official Pet Store API — production ready."
paths:
  /pets:
    get:
      summary: List all pets`}
      title="After — description updated"
    />
  </div>

  <h2 class="text-2xl font-semibold mt-8 mb-4">
    Example: Add Server &amp; Update Endpoint
  </h2>
  <CodeBlock
    client:idle
    code={`overlay: 1.0.0
info:
  title: Production overlay
  version: 1.0.0
actions:
  - target: "$"
    update:
      servers:
        - url: https://api.example.com/v1
          description: Production server
  - target: "$.paths['/pets'].get"
    update:
      summary: "List all pets (paginated)"
      description: "Returns a paginated list of pets."
      parameters:
        - name: limit
          in: query
          schema:
            type: integer`}
    title="overlay.yaml"
  />
  <PlaygroundExampleLink
    input={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
paths:
  /pets:
    get:
      summary: List all pets`}
    config={{
      overlaySet: `overlay: 1.0.0
info:
  title: Production overlay
  version: 1.0.0
actions:
  - target: "$"
    update:
      servers:
        - url: https://api.example.com/v1
          description: Production server
  - target: "$.paths['/pets'].get"
    update:
      summary: "List all pets (paginated)"
      description: "Returns a paginated list of pets."
      parameters:
        - name: limit
          in: query
          schema:
            type: integer`,
      toggleOverlay: true,
      outputLanguage: "yaml",
    }}
  />
  <div class="grid gap-4 md:grid-cols-2 mt-4">
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
paths:
  /pets:
    get:
      summary: List all pets`}
      title="Before"
    />
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: Pet Store API
  version: 1.0.0
servers:
  - url: https://api.example.com/v1
    description: Production server
paths:
  /pets:
    get:
      summary: "List all pets (paginated)"
      description: "Returns a paginated list of pets."
      parameters:
        - name: limit
          in: query
          schema:
            type: integer`}
      title="After — server & parameter added"
    />
  </div>

  <h2 class="text-2xl font-semibold mt-8 mb-4">Example: Remove Fields</h2>
  <CodeBlock
    client:idle
    code={`overlay: 1.0.0
info:
  title: Cleanup overlay
  version: 1.0.0
actions:
  - target: "$.paths['/internal/debug']"
    remove: true
  - target: "$.paths['/pets'].get.x-internal"
    remove: true`}
    title="overlay.yaml"
  />
  <PlaygroundExampleLink
    input={`openapi: 3.0.3
info:
  title: API
  version: 1.0.0
paths:
  /pets:
    get:
      x-internal: true
      summary: List all pets
  /internal/debug:
    get:
      summary: Debug endpoint`}
    config={{
      overlaySet: `overlay: 1.0.0
info:
  title: Cleanup overlay
  version: 1.0.0
actions:
  - target: "$.paths['/internal/debug']"
    remove: true
  - target: "$.paths['/pets'].get.x-internal"
    remove: true`,
      toggleOverlay: true,
      outputLanguage: "yaml",
    }}
  />
  <div class="grid gap-4 md:grid-cols-2 mt-4">
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: API
  version: 1.0.0
paths:
  /pets:
    get:
      x-internal: true
      summary: List all pets
  /internal/debug:
    get:
      summary: Debug endpoint`}
      title="Before"
    />
    <CodeBlock
      client:idle
      language="openapi"
      code={`openapi: 3.0.3
info:
  title: API
  version: 1.0.0
paths:
  /pets:
    get:
      summary: List all pets`}
      title="After — debug path & flag removed"
    />
  </div>

  <h2 class="text-2xl font-semibold mt-8 mb-4">Using extends</h2>
  <p class="mb-4 text-muted-foreground">
    The overlay can declare a base OpenAPI document with{" "}
    <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">extends</code
    >, making the input file optional:
  </p>
  <CodeBlock
    client:idle
    code={`overlay: 1.0.0
info:
  title: Overlay for Tic Tac Toe
  version: 1.0.0
extends: 'https://raw.githubusercontent.com/.../tictactoe.yaml'
actions:
  - target: "$"
    update:
      info:
        description: "Modified description"`}
    title="overlay.yaml"
  />
  <CodeBlock
    client:idle
    code={`# No input file needed when extends is set
npx openapi-format --overlayFile overlay.yaml -o openapi-updated.yaml`}
    title="Terminal"
  />

  <div
    class="mt-6 rounded-lg border bg-muted/30 p-4 text-sm text-muted-foreground"
  >
    <p class="font-semibold text-foreground mb-1">Notes</p>
    <ul class="list-disc list-inside space-y-1">
      <li>
        <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs"
          >extends</code
        > supports both local paths and remote HTTP(S) URLs
      </li>
      <li>
        Local relative paths are resolved relative to the overlay file's
        location
      </li>
    </ul>
  </div>
</DocsLayout>
