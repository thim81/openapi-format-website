---
const metrics = [
  {
    icon: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
    label: "GitHub Stars",
    value: "160+",
  },
  {
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
    label: "Monthly Downloads",
    value: "320K+",
  },
  {
    icon: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
    label: "Versions Released",
    value: "90",
  },
];
---

<section class="py-16 border-y bg-muted/20">
  <div class="container max-w-4xl">
    <p
      class="text-center text-sm font-medium text-muted-foreground mb-8 uppercase tracking-wider opacity-0"
      data-animate
      style="--animation: fade-in 0.4s ease"
    >
      Trusted by the OpenAPI community
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      {
        metrics.map((m, i) => (
          <div
            class="flex flex-col items-center text-center gap-2 opacity-0"
            data-animate
            style={`--animation: fade-in-up 0.4s ease ${i * 0.08}s`}
          >
            <svg
              class="h-6 w-6 text-primary"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={m.icon}
            />
            <span class="text-3xl font-extrabold tracking-tight">
              {m.value}
            </span>
            <span class="text-sm text-muted-foreground">{m.label}</span>
          </div>
        ))
      }
    </div>
    <p
      class="mt-8 text-center text-sm text-muted-foreground opacity-0"
      data-animate
      style="--animation: fade-in 0.4s ease 0.2s"
    >
      More OpenAPI tools from the community can be found on{" "}
      <a
        href="https://openapi.tools/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-foreground transition-colors"
      >
        openapi.tools
      </a>.
    </p>
  </div>
</section>
