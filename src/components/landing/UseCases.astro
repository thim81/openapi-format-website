---
const cases = [
  { icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>', title: 'Public Docs', desc: 'Strip internal endpoints and sort your spec before publishing external documentation.' },
  { icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>', title: 'Maintenance', desc: 'Keep large OpenAPI files readable and diff-friendly for easier code reviews.' },
  { icon: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>', title: 'CI/CD', desc: 'Automate formatting and filtering in your pipeline to enforce spec standards.' },
];
---

<section id="use-cases" class="py-20">
  <div class="container max-w-4xl">
    <h2
      class="text-3xl font-bold text-center mb-12 opacity-0"
      data-animate style="--animation: fade-in-up 0.5s ease"
    >
      Use Cases
    </h2>
    <div class="grid gap-6 md:grid-cols-3">
      {cases.map((c, i) => (
        <div
          class="opacity-0"
          data-animate
          style={`--animation: fade-in-up 0.4s ease ${i * 0.1}s`}
        >
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm h-full">
            <div class="flex flex-col space-y-1.5 p-6">
              <svg class="h-8 w-8 text-primary mb-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              <h3 class="text-xl font-semibold leading-none tracking-tight">{c.title}</h3>
              <p class="text-sm text-muted-foreground">{c.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
