---
const installCommand =
  'npx skills add https://github.com/thim81/openapi-format --skill openapi-format';
const skillUrl = 'https://skills.sh/thim81/openapi-format/openapi-format';
const promptExample =
  'Use openapi-format on ./openapi.yaml to sort paths by tags, remove internal endpoints, and write the result to ./openapi-public.yaml. Show me the exact command and the filter config you used.';

const valuePoints = [
  {
    title: 'Consistent outputs',
    description:
      'Claude, Codex, and similar agents can rely on the same openapi-format behavior instead of inventing formatting rules on the fly.',
  },
  {
    title: 'Faster OpenAPI editing',
    description:
      'Use agents to sort, filter, inspect, and refine OpenAPI files while keeping the actual spec transformations grounded in a real tool.',
  },
  {
    title: 'Tool-backed changes',
    description:
      'Keep agent output in a real CLI workflow so OpenAPI changes are easier to inspect, reproduce, and trust.',
  },
];
---

<section id="llm-showcase" class="border-t py-20 bg-muted/20">
  <div class="container max-w-6xl">
    <div
      class="text-center mb-12 opacity-0"
      data-animate
      style="--animation: fade-in-up 0.5s ease"
    >
      <div class="mb-4 inline-flex items-center rounded-full border bg-background/70 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
        Claude, Codex &amp; Skills
      </div>
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Use openapi-format with LLMs</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-7 text-muted-foreground">
        Bring `openapi-format` into Claude, OpenAI Codex, and other agent-based workflows through
        Skills so OpenAPI tasks stay grounded in a consistent CLI-based workflow.
      </p>
    </div>

    <section
      class="rounded-3xl border bg-card p-6 shadow-sm opacity-0 md:p-8"
      data-animate
      style="--animation: fade-in-up 0.5s ease 0.08s"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-start">
        <div class="min-w-0">
          <h3 class="text-2xl font-semibold tracking-tight">Install the skill once</h3>
          <p class="mt-4 max-w-2xl text-base leading-7 break-words text-muted-foreground">
            Add the
            <a
              href={skillUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="break-words font-medium text-foreground underline underline-offset-4 transition-colors hover:text-primary"
            >
              `openapi-format` skill
            </a>
            to your local skills setup so LLM-assisted OpenAPI work stays predictable across
            editing, cleanup, and review tasks.
          </p>

          <div class="mt-6 rounded-2xl border bg-background p-4">
            <div class="mb-2 flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
              <p>Install Command</p>
              <button
                type="button"
                class="llm-copy-button inline-flex items-center text-muted-foreground hover:text-foreground transition-colors"
                data-copy={installCommand}
                aria-label="Copy install command"
              >
                <svg class="llm-copy-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <svg class="llm-check-icon hidden h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </div>
            <pre class="overflow-x-auto text-sm leading-6"><code>{installCommand}</code></pre>
          </div>

          <div class="mt-6 rounded-2xl border bg-background p-4">
            <div class="mb-2 flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
              <p>Prompt Example</p>
              <button
                type="button"
                class="llm-copy-button inline-flex items-center text-muted-foreground hover:text-foreground transition-colors"
                data-copy={promptExample}
                aria-label="Copy prompt example"
              >
                <svg class="llm-copy-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <svg class="llm-check-icon hidden h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </div>
            <pre class="overflow-x-auto whitespace-pre-wrap text-sm leading-6"><code>{promptExample}</code></pre>
          </div>
        </div>

        <div class="grid gap-4">
          {valuePoints.map((point, index) => (
            <article
              class="rounded-2xl border bg-background p-5"
              data-animate
              style={`--animation: fade-in-up 0.45s ease ${0.14 + index * 0.08}s`}
            >
              <h4 class="text-lg font-semibold">{point.title}</h4>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{point.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</section>

<script>
  document.querySelectorAll('.llm-copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy') ?? '';
      const copyIcon = button.querySelector('.llm-copy-icon');
      const checkIcon = button.querySelector('.llm-check-icon');

      await navigator.clipboard.writeText(text);

      if (!copyIcon || !checkIcon) {
        return;
      }

      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');

      window.setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 1600);
    });
  });
</script>
