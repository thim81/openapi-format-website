---
const installCmd = "npx openapi-format openapi.yaml";
---

<section class="py-20 md:py-32">
  <div class="container flex flex-col items-center text-center gap-6 max-w-3xl">
    <h1
      class="text-4xl md:text-6xl font-extrabold tracking-tight opacity-0"
      data-animate
      style="--animation: fade-in-up 0.6s ease"
    >
      Format, Sort &amp; Filter your OpenAPI definitions
    </h1>
    <p
      class="text-lg md:text-xl text-muted-foreground max-w-2xl opacity-0"
      data-animate
      style="--animation: fade-in-up 0.6s ease 0.15s"
    >
      A CLI and library to sort, filter, and format OpenAPI specs — making them
      consistent, clean, and diff-friendly.
    </p>

    <!-- npm install -->
    <div
      class="flex items-center gap-2 rounded-lg border bg-muted/50 px-4 py-2.5 font-mono text-sm opacity-0"
      data-animate
      style="--animation: fade-in-up 0.6s ease 0.3s"
    >
      <span class="text-muted-foreground select-none">$</span>
      <code class="select-all">{installCmd}</code>
      <button
        id="hero-copy-btn"
        class="ml-2 text-muted-foreground hover:text-foreground transition-colors"
        aria-label="Copy"
        data-copy={installCmd}
      >
        <svg
          class="h-4 w-4 copy-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path
            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path></svg
        >
        <svg
          class="h-4 w-4 check-icon hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg
        >
      </button>
    </div>

    <!-- CTAs -->
    <div
      class="flex flex-wrap gap-3 justify-center opacity-0"
      data-animate
      style="--animation: fade-in-up 0.6s ease 0.45s"
    >
      <a
        href="https://github.com/thim81/openapi-format"
        target="_blank"
        rel="noopener noreferrer"
      >
        <button
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-11 px-8 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          <svg
            class="h-4 w-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
          >
          GitHub
        </button>
      </a>
      <a
        href="https://playground.openapi-format.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        <button
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-11 px-8 border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          <svg
            class="h-4 w-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path
              d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path></svg
          >
          Playground
        </button>
      </a>
    </div>
  </div>
</section>

<script>
  document
    .getElementById("hero-copy-btn")
    ?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const text = btn.dataset.copy ?? "";
      await navigator.clipboard.writeText(text);
      btn.querySelector(".copy-icon")?.classList.add("hidden");
      btn.querySelector(".check-icon")?.classList.remove("hidden");
      setTimeout(() => {
        btn.querySelector(".copy-icon")?.classList.remove("hidden");
        btn.querySelector(".check-icon")?.classList.add("hidden");
      }, 2000);
    });
</script>
